# ==========================================================
# ConvergenceTerminal — Environment Configuration Template
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real credentials below.
#   3. NEVER commit .env to version control.
#      .env is listed in .gitignore — confirm with:
#        git check-ignore -v .env
#
# SECURITY NOTE:
#   If a live API key was ever committed to this repo's history,
#   treat it as compromised and rotate it immediately, then scrub
#   history using one of:
#     • git filter-repo (recommended): https://github.com/newren/git-filter-repo
#     • BFG Repo Cleaner:              https://rtyley.github.io/bfg-repo-cleaner/
#   After scrubbing, force-push all branches and invalidate
#   any existing clones or forks.
# ==========================================================

# ── Twitter / X Data Relay ─────────────────────────────────
# Obtain from: https://twitterapi.io  (pay-as-you-go, ~$0.15/1k tweets)
TWITTER_API_KEY=your_twitterapi_io_key_here
TWITTERAPI_IO_KEY=your_twitterapi_io_key_here

# ── Google Gemini AI (for live synthesis) ─────────────────
# Obtain from: https://aistudio.google.com/app/apikey
# Required when enabling live Gemini-powered Alden lens synthesis.
# Not needed for offline staging with mock_inputs.json.
GEMINI_API_KEY=your_gemini_api_key_here
